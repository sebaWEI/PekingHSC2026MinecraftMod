{
	"schemaVersion": 1,
	"id": "synbio",
	"version": "${0.0.1}",
	"name": "SynBio Crafter",
	"description": "A great synthetic biology mod for the iGEM competition",
	"authors": [
		"Ziheng Wei"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/synbio/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"name.modid.IgemMod"
		],
		"client": [
			"name.modid.client.IgemModClient"
		],
		"fabric-datagen": [
			"name.modid.client.IgemModDataGenerator"
		]
	},
	"mixins": [
		"synbio.mixins.json",
		{
			"config": "synbio.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}